# Port server Express lokal
PORT=4000

# Zona waktu penentu pergantian hari
APP_TIMEZONE=Asia/Jakarta

# Lokasi file JSON (opsional, default: server/data/db.json)
# DATA_FILE=./data/db.json

# Isi dua variabel ini untuk memakai Upstash Redis (wajib saat deploy ke Vercel).
# Jika kosong, server lokal otomatis memakai file JSON.
# Nama KV_REST_API_URL / KV_REST_API_TOKEN (dari integrasi Vercel) juga didukung.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Prefix key Redis (berguna nanti untuk multi-user)
# STORAGE_PREFIX=habit
